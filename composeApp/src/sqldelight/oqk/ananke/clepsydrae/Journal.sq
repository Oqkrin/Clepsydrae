CREATE TABLE Journal (
dayNum INTEGER NOT NULL,
dayName TEXT NOT NULL,
monthNum INTEGER NOT NULL,
monthName TEXT NOT NULL,
year INTEGER NOT NULL,
initTimeStamp TEXT NOT NULL,
finTimeStamp TEXT DEFAULT NULL,
entry TEXT,
PRIMARY KEY (dayNum, monthNum, year, initTimeStamp)
);

CREATE INDEX idx_journal_end ON Journal(finTimeStamp);

insertEntry:
INSERT OR IGNORE INTO Journal(dayNum, dayName, monthNum, monthName, year ,initTimeStamp, finTimeStamp, entry)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectJournalOfDay:
SELECT * FROM Journal
WHERE dayNum = :dayNum AND monthNum = :monthNum AND year = :year
UNION
SELECT * FROM Journal
WHERE dayNum = :prevDayNum AND monthNum = :prevMonthNum AND year = :prevYear AND finTimeStamp IS NULL;

updateEntry:
UPDATE OR IGNORE Journal SET
finTimeStamp = :end,
entry = :entry
WHERE dayNum = :dayNum AND monthNum = :monthNum AND year = :year AND initTimeStamp = :init;

deleteEntry:
DELETE FROM Journal WHERE dayNum = :dayNum AND monthNum = :monthNum AND year = :year AND initTimeStamp = :initTimeStamp;