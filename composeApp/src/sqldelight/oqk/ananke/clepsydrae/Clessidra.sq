CREATE TABLE clepsydra (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT,
    note TEXT,
    tags TEXT,
    init_time INTEGER NOT NULL,
    last_state_change INTEGER NOT NULL,
    total_active_time INTEGER NOT NULL DEFAULT 0,
    total_passive_time INTEGER NOT NULL DEFAULT 0,
    is_active INTEGER NOT NULL DEFAULT 0,
    ended INTEGER NOT NULL DEFAULT 0,
    session_id INTEGER,
    pomodoro_active INTEGER NOT NULL DEFAULT 0,
    pomodoro_passive INTEGER NOT NULL DEFAULT 0,
    fin INTEGER
);

CREATE INDEX idx_init_time ON clepsydra(init_time);

insertClepsydra:
INSERT INTO clepsydra(name, note, tags, init_time, last_state_change, total_active_time, total_passive_time, is_active, ended, session_id, pomodoro_active, pomodoro_passive, fin)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

selectAllClepsydrae:
SELECT * FROM clepsydra;

selectClepsydraById:
SELECT * FROM clepsydra WHERE id = ?;

selectClepsydraeByDate:
SELECT * FROM clepsydra 
WHERE init_time >= ? AND init_time < ?;

updateClepsydra:
UPDATE clepsydra SET
    name = ?,
    note = ?,
    tags = ?,
    last_state_change = ?,
    total_active_time = ?,
    total_passive_time = ?,
    is_active = ?,
    ended = ?,
    pomodoro_active = ?,
    pomodoro_passive = ?,
    fin = ?
WHERE id = ?;

deleteClepsydra:
DELETE FROM clepsydra WHERE id = ?;
